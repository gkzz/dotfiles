#!/usr/bin/env bash

set -u

readonly SECRETLINT_IMAGE="secretlint/secretlint:v13.0.4@sha256:3b3f8d2ea61ab21ce1f8185d69e7cad12e040fa5370d8f5462dd366fd24ef765"
temporary_directory=

run_repository_pre_commit() {
  local common_dir local_hook

  common_dir="$(git rev-parse --git-common-dir)" || {
    printf '%s\n' 'pre-commit: failed to locate the Git directory' >&2
    return 1
  }
  if [[ "$common_dir" != /* ]]; then
    common_dir="$(cd "$common_dir" && pwd -P)" || {
      printf '%s\n' 'pre-commit: failed to resolve the Git directory' >&2
      return 1
    }
  fi
  local_hook="$common_dir/hooks/pre-commit"

  if [ -x "$local_hook" ] && ! [ "$local_hook" -ef "$0" ]; then
    "$local_hook" || return $?
  fi
}

extract_index() {
  local destination entry metadata file directory
  destination=$1

  while IFS= read -r -d '' entry; do
    metadata=${entry%%$'\t'*}
    file=${entry#*$'\t'}
    if [[ "$metadata" == 160000\ * ]]; then
      continue
    fi
    directory="$destination/${file%/*}"
    if [ "$directory" != "$destination/$file" ]; then
      mkdir -p "$directory" || return 1
    fi
    git show ":0:$file" >"$destination/$file" || return 1
  done < <(git ls-files --cached --stage -z)
}

create_secretlintignore() {
  local destination global_secretlintignore
  destination=$1
  global_secretlintignore="${HOME:-}/.secretlintignore"

  : >"$destination" || return 1

  if [ -n "${HOME:-}" ] && [ -f "$global_secretlintignore" ]; then
    cat "$global_secretlintignore" >>"$destination" || return 1
    printf '\n' >>"$destination" || return 1
  fi

  if git cat-file -e ':.secretlintignore' 2>/dev/null; then
    git show ':.secretlintignore' >>"$destination" || return 1
    printf '\n' >>"$destination" || return 1
  fi
}

has_secretlint_config() {
  local config

  while IFS= read -r config; do
    [ -n "$config" ] && return 0
  done < <(
    git ls-files --cached -- \
      '.secretlintrc' \
      '.secretlintrc.json' \
      '.secretlintrc.yaml' \
      '.secretlintrc.yml' \
      '.secretlintrc.js' \
      '.secretlintrc.cjs'
  )

  git show ':package.json' 2>/dev/null |
    awk '
      BEGIN { depth = 0; in_string = 0; escaped = 0; key = ""; candidate = "" }
      {
        for (position = 1; position <= length($0); position++) {
          character = substr($0, position, 1)
          if (in_string) {
            if (escaped) {
              escaped = 0
            } else if (character == "\\") {
              escaped = 1
            } else if (character == "\"") {
              in_string = 0
              if (depth == 1) candidate = key
            } else if (depth == 1) {
              key = key character
            }
          } else {
            if (candidate != "" && character !~ /[[:space:]]/) {
              if (depth == 1 && candidate == "secretlint" && character == ":") {
                  found = 1
                  exit
              }
              candidate = ""
            }
            if (character == "\"") {
              in_string = 1
              key = ""
            } else if (character == "{" || character == "[") {
              depth++
            } else if (character == "}" || character == "]") {
              depth--
            }
          }
        }
      }
      END { exit !found }
    '
}

create_default_secretlint_config() {
  local destination
  destination=$1

  printf '%s\n' \
    '{' \
    '  "rules": [' \
    '    { "id": "@secretlint/secretlint-rule-preset-recommend" }' \
    '  ]' \
    '}' >"$destination"
}

main() {
  local file status
  local -a config_arguments=() staged_files=()

  run_repository_pre_commit || return $?

  git diff --cached --quiet --diff-filter=ACMRT --
  status=$?
  case "$status" in
    0) return 0 ;;
    1) ;;
    *)
      printf '%s\n' 'pre-commit: failed to inspect staged files' >&2
      return "$status"
      ;;
  esac

  temporary_directory="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-secretlint.XXXXXX")" || {
    printf '%s\n' 'pre-commit: failed to create a temporary directory' >&2
    return 1
  }
  trap 'rm -rf -- "$temporary_directory"' EXIT

  if ! git diff --cached --name-only -z --diff-filter=ACMRT >"$temporary_directory/staged-files"; then
    printf '%s\n' 'pre-commit: failed to list staged files' >&2
    return 1
  fi

  while IFS= read -r -d '' file; do
    if [[ "$(git ls-files --stage -- "$file")" == 160000\ * ]]; then
      continue
    fi
    staged_files+=("./$file")
  done <"$temporary_directory/staged-files"

  if [ "${#staged_files[@]}" -eq 0 ]; then
    return 0
  fi

  if ! command -v docker >/dev/null 2>&1; then
    printf '%s\n' 'pre-commit: Docker is required to run secretlint' >&2
    return 1
  fi

  if ! mkdir "$temporary_directory/repository"; then
    printf '%s\n' 'pre-commit: failed to create the index snapshot directory' >&2
    return 1
  fi

  if ! extract_index "$temporary_directory/repository"; then
    printf '%s\n' 'pre-commit: failed to read the Git index' >&2
    return 1
  fi

  if ! create_secretlintignore "$temporary_directory/.secretlintignore.effective"; then
    printf '%s\n' 'pre-commit: failed to prepare secretlint ignore rules' >&2
    return 1
  fi

  if ! has_secretlint_config; then
    if ! create_default_secretlint_config "$temporary_directory/.secretlintrc.default.json"; then
      printf '%s\n' 'pre-commit: failed to prepare the default secretlint configuration' >&2
      return 1
    fi
    config_arguments=(--secretlintrc /scan/.secretlintrc.default.json)
  fi

  printf '%s\n' "pre-commit: checking staged files with $SECRETLINT_IMAGE"
  docker run \
    --rm \
    --network none \
    --mount "type=bind,source=$temporary_directory,target=/scan,readonly" \
    --workdir /scan/repository \
    "$SECRETLINT_IMAGE" \
    secretlint \
    --no-gitignore \
    --secretlintignore /scan/.secretlintignore.effective \
    ${config_arguments[@]+"${config_arguments[@]}"} \
    "${staged_files[@]}"
  status=$?
  return "$status"
}

main "$@"
