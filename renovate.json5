{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "github>gkzz/renovate-config",
    "github>gkzz/renovate-config:actions-lock",
  ],

  // lockfile は下記スケジュールで更新し、差分がある場合のみメンテナンス PR を作成する。
  // タイムゾーン（Asia/Tokyo）と Dashboard の事前承認は共有 Preset を継承する。
  lockFileMaintenance: {
    // 毎月第1月曜日（日付1〜7日と月曜日のAND条件）。
    enabled: true,
    schedule: ["* * 1-7 * 1"],
  },

  // pnpm 本体は mise.toml/mise.lock だけで固定し、下記の JavaScript グループで更新する。
  // devDependencies の更新には npm マネージャーを引き続き使用する。
  mise: {
    managerFilePatterns: ["/mise.toml$/"],
  },

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^mise\\.toml$/"],
      matchStrings: ['min_version = "(?<currentValue>[^"\\s]+)"'],
      depNameTemplate: "mise",
      packageNameTemplate: "jdx/mise",
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver",
      extractVersionTemplate: "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      // 添付ファイルのデータソースで、各 digest を対応するリリースのアセットに紐付ける。
      customType: "regex",
      managerFilePatterns: ["/^mise\\.env$/"],
      matchStrings: [
        '# mise (?<currentValue>v[0-9.]+) (?<depName>[^\\s]+)\\nMISE_SHA256_[A-Z0-9_]+="(?<currentDigest>[a-f0-9]{64})"',
      ],
      packageNameTemplate: "jdx/mise",
      datasourceTemplate: "github-release-attachments",
      versioningTemplate: "semver",
    },
  ],

  packageRules: [
    {
      // 共有 Preset の toolchain グループを解除し、未分類のツールは個別に更新する。
      matchManagers: ["mise"],
      groupName: null,
      groupSlug: null,
    },
    {
      matchManagers: ["mise"],
      matchDepNames: ["codex"],
      groupName: "AI tools",
      groupSlug: "mise-ai",
    },
    {
      matchManagers: ["mise"],
      matchDepNames: ["pnpm", "biome"],
      groupName: "JavaScript tools",
      groupSlug: "mise-javascript",
    },
    {
      matchManagers: ["mise"],
      matchDepNames: ["python", "uv"],
      groupName: "Python tools",
      groupSlug: "mise-python",
    },
    {
      matchManagers: ["mise"],
      matchDepNames: ["go", "go:github.com/gkzz/renodash"],
      groupName: "Go tools",
      groupSlug: "mise-go",
    },
    {
      matchManagers: ["mise"],
      matchDepNames: ["java"],
      groupName: "Java tools",
      groupSlug: "mise-java",
      // mise.lock の temurin- 接頭辞も含めて比較する。標準の java-version では invalid-version になる。
      versioning: "regex:^(?:temurin-)?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+(?<build>\\d+)(?:\\.0\\.LTS)?$",
    },
    {
      matchManagers: ["mise"],
      matchDepNames: ["ghq", "peco", "direnv"],
      groupName: "Shell and development utilities",
      groupSlug: "mise-shell-utilities",
    },
    {
      // Codex の rust-v タグから安定版を抽出し、リリース公開日を待機期間の基準にする。
      matchManagers: ["mise"],
      matchDepNames: ["codex"],
      matchPackageNames: ["openai/codex"],
      extractVersion: "^rust-v(?<version>\\d+\\.\\d+\\.\\d+)$",
      overrideDatasource: "github-releases",
      // リリース頻度に合わせ、Codex の待機期間は3日とする。
      minimumReleaseAge: "3 days",
    },
    {
      matchManagers: ["custom.regex"],
      matchPackageNames: ["jdx/mise"],
      groupName: "mise CLI",
      groupSlug: "mise-cli",
      // 年をまたぐ major 更新も、全環境の digest と同じ PR にまとめる。
      separateMajorMinor: false,
    },
    {
      // Node.js の major 更新は Renovate の提案対象から除外する。
      description: "Node.js の major 更新を無効にする",
      matchManagers: ["mise"],
      matchPackageNames: ["node"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      // Node.js をツール群のグループから外し、patch と minor の更新 PR を分ける。
      // patch 更新の確認後（PR のマージ後など）に、Dependency Dashboard で minor 更新を手動承認する。
      description: "Node.js の patch 更新と minor 更新を分ける",
      matchManagers: ["mise"],
      matchPackageNames: ["node"],
      groupName: null,
      groupSlug: null,
      separateMinorPatch: true,
    },
  ],
}
