{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: ["github>gkzz/renovate-config"],

  // lockfile は下記スケジュールで更新し、差分がある場合のみメンテナンス PR を作成する。
  // タイムゾーン（Asia/Tokyo）と Dashboard の事前承認は共有 Preset を継承する。
  lockFileMaintenance: {
    // 毎月第1月曜日（日付1〜7日と月曜日のAND条件）。
    enabled: true,
    schedule: ["* * 1-7 * 1"],
  },

  mise: {
    managerFilePatterns: ["/mise.toml$/"],
  },

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^mise\\.toml$/"],
      matchStrings: ['min_version = "(?<currentValue>[^"\\s]+)"'],
      depNameTemplate: "mise",
      packageNameTemplate: "jdx/mise",
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver",
      extractVersionTemplate: "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      // The attachment datasource maps each existing digest to its release asset.
      customType: "regex",
      managerFilePatterns: ["/^mise\\.env$/"],
      matchStrings: [
        '# mise (?<currentValue>v[0-9.]+) (?<depName>[^\\s]+)\\nMISE_SHA256_[A-Z0-9_]+="(?<currentDigest>[a-f0-9]{64})"',
      ],
      packageNameTemplate: "jdx/mise",
      datasourceTemplate: "github-release-attachments",
      versioningTemplate: "semver",
    },
  ],

  packageRules: [
    {
      matchManagers: ["custom.regex"],
      matchPackageNames: ["jdx/mise"],
      groupName: "mise CLI",
      groupSlug: "mise-cli",
      // Keep a year-boundary release in the same PR as all platform digests.
      separateMajorMinor: false,
    },
  ],
}
