#!/usr/bin/env bash
set -euo pipefail

dry_run=true
force=false
skip_brew=false
operation=""
mode_explicit=false

usage() {
  cat <<'USAGE'
usage: bin/dotfiles <install|check|uninstall> [OPTIONS]

Operations:
  install        Converge packages, tools, and managed symlinks
  check          Validate managed configuration without repairing it
  uninstall      Remove symlinks that still point to this repository

Options:
  --dry-run       dry-run install/uninstall (default)
  --apply         Apply install/uninstall
  --force         Back up replaceable symlink conflicts during install
  --skip-brew     Skip Homebrew inspection and actions
  -h, --help      Show this help
USAGE
}

DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
case "$DOTFILES" in
  /*) ;;
  *) printf 'error: DOTFILES must be an absolute path: %s\n' "$DOTFILES" >&2; exit 1 ;;
esac
[ -d "$DOTFILES" ] || { printf 'error: DOTFILES directory is missing: %s\n' "$DOTFILES" >&2; exit 1; }

if [ "$#" -eq 0 ]; then
  usage >&2
  exit 2
fi

case "$1" in
  install|check|uninstall) operation="$1"; shift ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run)
      if "$mode_explicit" && ! "$dry_run"; then
        printf 'error: --dry-run and --apply are mutually exclusive\n' >&2
        exit 2
      fi
      dry_run=true
      mode_explicit=true
      ;;
    --apply)
      if "$mode_explicit" && "$dry_run"; then
        printf 'error: --dry-run and --apply are mutually exclusive\n' >&2
        exit 2
      fi
      dry_run=false
      mode_explicit=true
      ;;
    --force) force=true ;;
    --skip-brew) skip_brew=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

case "$operation" in
  check)
    "$mode_explicit" && { printf 'error: check does not accept --dry-run or --apply\n' >&2; exit 2; }
    "$force" && { printf 'error: check does not accept --force\n' >&2; exit 2; }
    ;;
  uninstall)
    "$force" && { printf 'error: uninstall does not accept --force\n' >&2; exit 2; }
    "$skip_brew" && { printf 'error: uninstall does not accept --skip-brew\n' >&2; exit 2; }
    ;;
esac

export DOTFILES HOME

# shellcheck source=setup/lifecycle.bash
. "$DOTFILES/setup/lifecycle.bash"
configure_github_actions_environment
initialize_setup_context

case "$operation" in
  install) install_lifecycle ;;
  check) check_lifecycle ;;
  uninstall) uninstall_lifecycle ;;
esac
